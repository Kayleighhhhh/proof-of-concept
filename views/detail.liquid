{% render 'partials/head.liquid' %}

<main class="detail">

  <header>
    <h1><a href="{{ item.link }}">{{title}}</a></h1>
  </header>

  <section class="donut">
    <img src="/assets/donutplaceholder.png" width="250">
  </section>

  <section class="preview">
    <h2>{{ item.name }}</h2>
    <p>{{ item.preview }}</p>
  </section>

  <section class="message-box">
    <h2>stuur een bericht</h2>
    <article class="sent-messages">
      {% comment %} {% for message in messages %} {% endcomment %}
      <p>hallo</p>
    </article>
    <form action="/{{ item.id }}" method="POST">
      <label for="bericht">typ hier je bericht <input type="text" id="bericht" placeholder="..." required></label>
      <button class="submit" type="submit">submit</button>
    </form>
  </section>
</main>
{% render 'partials/foot.liquid' %}
