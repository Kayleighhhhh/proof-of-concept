{% render 'partials/head.liquid' %}

<main class="detail">
  <header>
    <h1>
      <a href="{{ item.link }}" style="view-transition-name:name-{{ item.id }}; view-transition-class:vt-name;">{{ title }}</a>
    </h1>
  </header>

  <section class="donut">
    {% render 'partials/pie.liquid', chartData: peopleCount, names: 'name', values: 'count', limit: 10 %}
  </section>

  <section class="preview">
    <h2>{{ item.name }}</h2>
    <p>{{ item.preview }}</p>
  </section>

  <section class="message-box">
    <h2>stuur een bericht</h2>

    <article class="sent-messages">
      {% for bericht in berichten %}
        <p>{{ bericht.text }}</p>
      {% endfor %}
    </article>

    <form action="/{{ item.id }}" method="POST" class="form">
      <label for="text"
        >typ hier je bericht
        <input type="text" id="text" name="text" placeholder="..." required>
      </label>

      <input type="hidden" name="id" value="{{ item.id }}">
      <button class="submit" type="submit">submit</button>
    </form>
  </section>
</main>

<script type="module">

    const form = document.querySelector(".form")
    const button = form.querySelector("button")
    const berichten = document.querySelector(".sent-messages")

    const originalButtonText = button.textContent

    form.addEventListener("submit", async function(event) {

        event.preventDefault()

        button.classList.add("loading")
        button.textContent = "laden..."

        let formData = new FormData(form);

        const response = await fetch(form.action, {
            method: form.method,
            body: new URLSearchParams(formData)
        })

        const responseData = await response.text()

        const parser = new DOMParser()
        const responseDOM = parser.parseFromString(responseData, 'text/html')

        const newState = responseDOM.querySelector(".sent-messages")

        berichten.innerHTML = newState.innerHTML

        console.log("Loading state weghalen")
        button.classList.remove("loading")
        button.textContent = "gelukt!✅"

        setTimeout(() => {
          button.textContent = originalButtonText
        }, 1000)
    })
</script>
{% render 'partials/foot.liquid' %}
