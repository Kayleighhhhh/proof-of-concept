{% render 'partials/head.liquid' %}

<main class="dashboard">

    <section class="active-topics category-content categories">
        <div class="content-header">
        <h1 class="headings">Alle Actieve topics</h1>
        <h2 class="headings">Reacties</h2>
        </div>

        <ul class="topic-list">
            <li class="topic-item">
                <a href="/2337274" class="topic-link" style="view-transition-name:name-2337274; view-transition-class:vt-name;">Resident Evil Veronica</a>
                <p class="topic-replies">345</p>
            </li>
            <li class="topic-item">
                <a href="/2328168" class="topic-link" style="view-transition-name:name-2328168; view-transition-class:vt-name;">Tesla FSD in NL: Ride‑alongs en ervaringen met FSD</a>
                <p class="topic-replies">9248</p>
            </li>
            <li class="topic-item">
                <a href="/1678737" class="topic-link" style="view-transition-name:name-1678737; view-transition-class:vt-name;">[Vimexx] Ervaringen & Discussie</a>
                <p class="topic-replies">720</p>
            </li>
            <li class="topic-item">
                <a href="/2312952" class="topic-link" style="view-transition-name:name-2312952; view-transition-class:vt-name;">[Multi] Forza Horizon 6</a>
                <p class="topic-replies">2079</p>
            </li>
            <li class="topic-item">
                <a href="/2082356" class="topic-link" style="view-transition-name:name-2082356; view-transition-class:vt-name;">Het grote gravelbike topic (Deel 1)</a>
                <p class="topic-replies">9652</p>
            </li>
        </ul>
    </section>

  {% for categorie in dashboardData %}
    <details class="categories">
      <summary class="category-summary">
        <h2 class="headings">{{ categorie.naam }}</h2>
        <span class="v">V</span>
      </summary>

      <div class="category-content">
        <div class="content-header">
          <h3 class="headings">Actieve topics</h3>
          <h3 class="headings">reacties</h3>
        </div>

        <ul class="topic-list">
          {% for topic in categorie.items %}
            <li class="topic-item">
              <a href="/{{ topic.link }}" class="topic-link" style="view-transition-name:name-{{ topic.link }}; view-transition-class:vt-name;">{{ topic.title }}</a>
              <p class="topic-replies">{{ topic.replies }}</p>
            </li>
          {% endfor %}
        </ul>
      </div>
    </details>
  {% endfor %}
</main>

{% render 'partials/foot.liquid' %}
